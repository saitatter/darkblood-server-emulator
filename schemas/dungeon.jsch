message 5229 ClearRankInfoAck ok_only
  ## Handler 0x00518A20 (assert: m_nCurPage >> nMapID >> vecClearRankInfo >> jDungeonClearRankInfo).
  u32 result
  i32 cur_page
  i32 map_id
  vector<DungeonClearRankInfo> rank_infos
  DungeonClearRankInfo my_rank_info = DungeonClearRankInfo()
