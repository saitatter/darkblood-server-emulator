  map<?> _                   # mapReward (0x00532F50)
end

message 5358 ExploreJoinReq bare
  ## Enter Forest of Oblivion (Explore mode); live capture has empty body.
end

message 5359 ExploreJoinAck ok_only
  ## Handler 0x006C35B0 (assert: mapExplorePoint >> ...): opens page 0x9B and
  ## transitions to eAS_Explore (Forest of Oblivion).
  u32 result
  map<?> _                   # mapExplorePoint (0x006B9060)
  map<?> _                   # 0x006C2190
  map<?> _                   # 0x006B9130
  u16 _                      # 0x00B351E0
end

message 5360 ExploreLeaveReq bare
  ## Leave Forest of Oblivion (Explore mode).
end

message 5361 ExploreLeaveAck
  ## Handler 0x006B5F00: transitions back to eAS_SquarePlay.
  u32 result
end

struct DungeonClearRankInfo
  ## Dungeon clear rank record, reader 0x00A51AC0 (2540 / 5229).
  i64 rank_uid
  i32 map_id
  i32 clear_time
  i32 rank
  i32 score
  i64 leader_uid
  i32 party_count
  wstr comment
  i32 param
  map<?> _                   # 0x00A51060
  vector<?> _                # 0x00A3EA40
  raw[12] clear_date
end

message 2539 ClearRankHistoryInfoReq header?
  ## Clear rank history request -> 2540.
  i32 map_id
  i32 page
end

message 2540 ClearRankHistoryInfoAck ok_only
  ## Handler 0x00518630 (assert: tStartTime >> m_nCurPage >> nMapID >> vecClearRankInfo >> jDungeonClearRankInfo).
  u32 result
  i64 start_time
  i32 cur_page
  i32 map_id
  vector<DungeonClearRankInfo> rank_infos
  DungeonClearRankInfo my_rank_info = DungeonClearRankInfo()
