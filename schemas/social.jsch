# Friends, chat, speaker items, contracts and remote inspection. Format: schemas/README.md.

domain social Dark Blood protocol wire messages - Social domain.
extern Character from darkblood.games.entities.character encode=encode_world_details
extern Item from darkblood.games.entities.items
extern RoomMemberInfo from darkblood.games.network.messages.dungeon readable

struct FriendEntry
  ## Friend struct, reader 0x00A49450 (2140 and the 2132 map).
  ## UI layout verified in Lua_OnUpdateFriendList (0x00500000.c:2026):
  ## +0x24 class, +0x25 level, +0x26 square_id (Page_SquareList lookup -> "Channel 1"),
  ## +0x2E memo, +0x52 is_online (gray "Offline" when false).
  i64 uid                    # +0x00 char uid
  wstr name                  # +0x08
  u8 char_class              # +0x24
  u8 level = 1               # +0x25
  i64 location = -1          # +0x26: square_id looked up in Page_SquareList (0x0062D540); -1 offline
  wstr memo                  # +0x2E: friend memo/comment
  i64 _                      # +0x4A
  bool is_online = true      # +0x52: online flag (filters "online only" & toggles "Offline")
end

message 2132 FriendListAck
  ## Reader 0x007712E0: map 0x0076AE20, key i64 uid (0x0074D520).
  u32 result
  map<i64,FriendEntry> friends
end

message 2139 FriendListAddReq header
  ## Sender 0x00791FA0. Live: ffffff7f + J-wstring name ("Mage1").
  wstr char_name
end

message 2140 FriendListAddAck ok_only
  ## On_eEGS_FRIEND_LIST_ADD_ACK 0x007591A0. 0xCE: not found (0x00AB29C0); 0x1A5
  ## another error. On success the client adds the entry to its list (0x00926800).
  i32 result = 0xCE
  FriendEntry friend = FriendEntry()
end

message 2135 FriendListDeleteReq header?
  ## Sender 0x00792500.
  i64 char_uid
end

message 2136 FriendListDeleteAck
  ## On_eEGS_FRIEND_LIST_DELETE_ACK 0x00759560.
  i32 result
  i64 char_uid
end

message 2133 FriendListUpdateReq header?
  ## Sender 0x007922E0: 0x00B353D0 uid, J-wstring comment.
  i64 char_uid
  wstr comment
end

message 2134 FriendListUpdateAck
  ## On_eEGS_FRIEND_LIST_UPDATE_ACK 0x00752E80: reads i32 result, i64 uid (0x00B35430),
  ## J-wstring memo (0x00B35AB0), then updates JFriendMgr via 0x00926B00.
  i32 result
  i64 char_uid
  wstr comment
end

message 5118 FriendMyConnectionNot
  ## Handler 0x0077A8A0.
  i64 char_uid
  bool is_online = true
  i64 param1                 # meaning unknown
  i64 param2                 # meaning unknown
end

message 5119 FriendMyDisconnectionNot
  ## Handler 0x00758FA0.
  i64 char_uid
  bool notify = true
end

message 5015 ChangeTeamReq header?
  i32 team_id
end

message 5016 ChangeTeamAck
  i32 result
  i32 team_id
end

message 5040 ChatReq
  ## Sender 0x007AC570 writes one struct (0x00A4DC70). Captures carry no header:
  ## normal: 01 80 80 8a "/bags" 00 1080 1080 01000000 ff...
  ## whisper: 02 90 "Warrior1" 80 8a "sadad" 00 1080 1080 01000000 ff...
  ## Field order verified in 0x00544310: +0x01 is target, +0x1D is sender.
  u8 channel
  wstr target
  wstr sender
  wstr message
  rest tail
end

message 5041 ChatAck ok_only
  ## Handler 0x007AC890 -> 0x00A53490 -> 0x00A52BD0 (bool + 2 vectors + 5 ints).
  ## Display 0x00544310 reads sender from +0x1D and target from +0x01.
  i32 result
  u8 channel
  wstr target
  wstr sender = 'System'
  wstr message
  bool _                     # +0x55 sub-struct flag (0x00A52BD0)
  vector<?> _
  vector<?> _
  i32 server_key = 31        # +0x76; must match local player's server key (0x1F) for whispers
  i64 sender_square_uid = 0x07C0000000000001 # +0x7A; bits 54-58 checked by 0x00544310 (else "(Other server)")
  i64 _
  i64 _
  i32 _
end

message 2128 UseSpeakerItemReq header?
  ## Sender 0x00792960: 0x00B353D0, J-wstring, 0x00B353D0.
  i64 speaker_uid
  wstr message
  i64 target_uid
end

message 2129 UseSpeakerItemAck ok_only
  ## On_eEGS_USE_SPEAKER_ITEM_ACK 0x0077F320.
  i32 result
  i64 speaker_uid
  vector<?> _                # updated item
end

message 2121 ContractUpdateReq header?
  i32 contract_id            # nContractID
end

message 2122 ContractUpdateAck
  ## On_eEGS_CONTRACT_UPDATE_ACK 0x00752D80.
  i32 result
  i32 contract_id
end

message 6011 RequestCharInfoReq header?
  ## Sender 0x00790C80: bool is_other, i64 target_char_uid, i64 requester_uid.
  ## Live 2026-11-21 (View Info on Knight1 from Warrior1): 01 | 1 | 2.
  bool is_other
  i64 char_uid
  i64 requester_uid
end

message 6012 RequestCharInfoAck ok_only
  ## Handler 0x00790FA0: i32 result, bool is_other, Character (0x00A52630),
  ## vector<Item> (0x004B9210), 2 vectors (0x004DAE90, 0x0076E9B0),
  ## 0x00A50B80 (i32 + f32 + 7*i32 + 0x00A4A0C0(8*i32) + map 0x00481E90),
  ## vector (0x004B13E0).
  i32 result
  bool is_other = true
  Character character = Character()
  vector<Item> items
  vector<?> _                # 0x004DAE90
  vector<?> _                # 0x0076E9B0
  i32 _                      # 0x00A50B80 +0x00
  f32 _                      # +0x04
  raw[28] _                  # +0x08..+0x23 (7 x i32)
  raw[32] _                  # 0x00A4A0C0 (+0x24..+0x43, 8 x i32)
  map<?> _                   # 0x00481E90
  vector<f32> proficiencies  # 0x004B13E0 (proficiency exp vector)
end

message 6028 RequestItemInfoReq header?
  ## Sender 0x007A4F20: 0x00B352B0 (4 bytes), 0x00B353D0, 0x00B353D0. Which i64 is
  ## the item uid is not confirmed.
  i32 _
  i64 item_uid
  i64 _
end

message 6029 RequestItemInfoAck
  ## Handler 0x00766C20. Item record not recovered (16 zero bytes).
  i32 result
  i64 item_uid
  ok_only
  raw[16] _
end

message 2024 GetInviteListReq header?
  ## Find user search. Sender 0x007AB560 (writer 0x0074BFF0); field names from its
  ## asserts: nHighLevel >= nLowLevel, nPageNum >= 0, ucJob <= eCK_Max and
  ## nSquareUID / iLayerNetID. Live 2026-11-21: 1, 2, 0, 7, -1, square 1.
  i32 low_level
  i32 high_level
  i32 page
  u8 job                     # 7 in the live capture (all classes, unverified)
  i64 layer_net_id = -1
  i64 square_uid
end

message 2025 GetInviteListAck
  ## Handler 0x006A2E10: i32 result, then vecInviteList (tag 0x10, elements read by
  ## 0x004B1AD0, the 0xA6-byte member struct of 5061).
  i32 result
  vector<RoomMemberInfo> users
end

message 2120 AlarmUpdateAck ok_only
  ## Handler 0x00771150 (assert: sType >> vecValue; vector reader 0x004D6E60).
  i32 result
  i16 alarm_type
  vector<i32> values
end

message 2354 ChatNotifyReq header?
  ## Sender 0x004E6D30 (struct writer 0x00A1EDD0): chat report/notification.
  i64 char_uid
  i32 category
  wstr target_name
  wstr message
  i64 timestamp
end

message 2355 ChatNotifyAck
  ## Reply to 2354 (no dedicated client handler in handler_map.txt).
  i32 result
end

struct FriendBlockEntry
  ## Block list entry, reader 0x00A4A1A0 (2566).
  i64 uid                    # +0x00 char uid
  wstr name                  # +0x08
  u8 char_class              # +0x24
  u8 level = 1               # +0x25
  wstr memo                  # +0x26
end

message 2565 FriendBlockListAddReq header?
  ## Sender 0x007A2930 (assert: strFriendBlockNick).
  wstr char_name
end

message 2566 FriendBlockListAddAck ok_only
  ## Handler 0x0075B640 (assert: jFriendBlockInfo, reader 0x00A4A1A0).
  i32 result = 0xCF
  FriendBlockEntry block = FriendBlockEntry()
end

message 2567 FriendBlockListDeleteReq header?
  ## Sender 0x007A2C70 (assert: nFriendBlockUID).
  i64 char_uid
end

message 2568 FriendBlockListDeleteAck ok_only
  ## Handler 0x0075B9B0 (assert: nFriendBlockUID).
  i32 result
  i64 char_uid
end

message 2571 FriendBlockListUpdateReq header?
  ## Sender 0x007A2F20 (assert: pjBlockInfo->m_nCharUID << strBlockMemo).
  i64 char_uid
  wstr memo
end

message 2572 FriendBlockListUpdateAck ok_only
  ## Handler 0x00753C80 (assert: nFriendBlockUID >> strBlockMemo).
  i32 result
  i64 char_uid
  wstr memo
end

message 2693 WatchEventSeenReq header?
  ## Request for 2694 (no sender recovered in build).
end

message 2694 WatchEventSeenAck
  ## Handler 0x00655800 -> 0x00759D60 (reads u32 result only).
  i32 result
end

message 5007 BanishUserReq header?
  ## Sender 0x005975D0 (assert: nForceLeaveUser). Room host kicks a member.
  i64 target_uid
end

message 5008 BanishUserAck ok_only
  ## Handler 0x005999A0 (assert: nLeaveUserUID). Broadcast to room and kicked user.
  i32 result
  i64 leave_user_uid
end

message 6018 RequestCharInfoByNickReq header?
  ## Sender 0x00790E10 (assert: strTargetNick << GetMyCharUID() << nDBUID).
  wstr target_nick
  i64 my_char_uid
  i64 db_uid
end
