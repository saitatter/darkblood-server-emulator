# Town duels, arena channels, rooms, teams and league rankings. Format: schemas/README.md.
# These flows are synthetic (not confirmed with the client). Compared with the
# earlier encoders: 0x1E bytes before structs are not sent (0x00B35010 consumes
# none), lists whose element layout is unknown are sent empty instead of as a
# bare length, and the team map is a valid empty map (17 80, not 17 00).
# The opcode "aliases" in the earlier docstrings (2446-2457, 2475-2478) belong to
# other messages in the client's table and are not used.

domain arena Dark Blood protocol wire messages - Arena, PvP Duels, and League domain.

extern PageCharTemp from darkblood.games.network.messages.lobby readable
extern RoomMemberInfo from darkblood.games.network.messages.dungeon readable

message 5100 DuelRequestReq header?
  ## Sender 0x006B7410.
  i64 target_uid
end

message 5101 DuelRequestAck
  ## Table case in 0x006D2610 -> 0x006C0A10.
  u32 result
  i64 target_uid
  wstr target_name = 'Opponent'
  u8 char_class = 1
  u8 level = 1
end

message 5097 DuelStartReq header?
  ## Sender 0x006B74C0: 0x00B353D0 then two 0x00B35510 values (kept raw).
  i64 opponent_uid
  rest tail
end

message 5098 DuelStartAck
  ## Table case in 0x006D2610 -> 0x006CBE60: result, 36-byte struct, map.
  u32 result
  raw[36] session_blob
  map<?> _
end

message 5099 DuelStartNot
  ## Table case in 0x006D2610 -> 0x006CCDF0: 36-byte struct.
  raw[36] session_blob
end

message 5105 DuelResultReq header?
  i64 winner_uid
  i64 loser_uid
end

message 5106 DuelResultAck
  ## Table case in 0x006D2610 -> 0x006CC6B0: result, 21-byte struct.
  u32 result
  raw[21] result_blob
end

message 5108 DuelGiveupNot
  i64 surrender_char_uid
end

message 5112 DuelRefuseReq header?
  i64 challenger_uid
end

message 5113 DuelRefuseAck
  ## Table case in 0x006D2610 -> 0x006B4120.
  u32 result
  i64 target_uid
  wstr target_name = 'Opponent'
  u8 char_class = 1
  u8 level = 1
end

message 2304 ArenaSquareListReq header?
  u32 server_key = 1
end

struct ArenaSquare
  ## Element 0x0049F160 -> 0x00A49700 (same reader as the 2022 channel entry).
  u64 square_id = 101
  wstr name = 'Arena 1'
  u32 _
  u32 load = 50
  u32 _
end

message 2305 ArenaSquareListAck
  ## Case in 0x004B7E80 -> 0x004B67F0.
  u32 result
  vector<ArenaSquare> squares
end

message 5138 ArenaJoinSquareAck
  u32 result
  i64 square_id = 101
end

struct ArenaRoomInfo
  ## sARENA_ROOM_INFO: base (0x00A49380 / 0x00A492F0) then extension
  ## (0x00A50A70 / 0x00A4F330). Field meanings beyond the names are guesses.
  u64 room_id = 1
  wstr room_name = 'Arena Room'
  u16 map_id = 1
  u16 game_mode = 1
  u32 max_players = 8
  u64 host_uid
  u64 team_id
  u32 state
  u32 min_level = 1
  u16 field10
  u16 field11
  u16 field12
  u16 field13
  u32 field14
  u32 field15
  u32 field16
  u16 field17
  wstr password
  wstr notice
  bool has_custom_map
  map<?> _                   # custom map data (never sent)
  u16 field22
  u32 field23
  u8 field24
end

message 2306 ArenaGetRoomListReq header?
  ## Sender 0x004A99A0: 0x00B352B0 (4 bytes), 0x00B35630.
  i32 page
  bool _
end

message 2307 ArenaGetRoomListAck
  ## Case in 0x004C6080 -> 0x004B96D0, item 0x0049E9C0 -> 0x00A50A70.
  u32 result
  bool flag = true
  i32 room_count             # sent equal to len(rooms)
  vector<ArenaRoomInfo> rooms
end

message 5153 ArenaCreateRoomReq header?
  ## Serializer 0x004C21E0 -> 0x0049E980 -> 0x00A4F330 (sender 0x004C1F70).
  ArenaRoomInfo room = ArenaRoomInfo()
end

message 5154 ArenaCreateRoomAck
  ## Case in 0x004C6080 -> 0x004BCCE0: result, room, 6-byte slot config.
  u32 result
  ArenaRoomInfo room = ArenaRoomInfo()
  raw[6] slot_config
end

message 5145 ArenaJoinRoomReq header?
  ## Encoded at 0x004C1C30.
  u64 room_id
  wstr password
end

message 5146 ArenaJoinRoomAck
  ## Handled at 0x004C6080 -> 0x004C5380.
  u32 result
  ArenaRoomInfo room = ArenaRoomInfo()
  u64 host_uid
  vector<?> _                # members, element layout unknown
end

message 5148 ArenaLeaveRoomReq header?
end

message 5149 ArenaLeaveRoomAck
  ## Handled at 0x004BB5B0.
  u32 result
  vector<?> _
  raw[14] _
  raw[14] _
end

message 2308 ArenaGetInviteListReq header?
end

message 2309 ArenaGetInviteListAck
  ## Case in 0x004C5200 -> 0x004B4680.
  u32 result
  vector<?> _                # invites, element layout unknown
end

struct ArenaTeamInfo
  ## Arena team record (server state; not tied to a recovered reader).
  i64 team_id = 1
  i16 team_type = 1
  i32 score = 1000
  i32 member_count = 1
  wstr team_name = 'Gladiators'
  wstr leader_name = 'Leader'
  wstr notice = 'Welcome to Arena Team'
  u64 timestamp
  i64 leader_uid
  u32 field10
  u32 field11
  u32 field12
  map<?> _
end

message 5269 ArenaTeamCreateReq header?
  wstr team_name = 'Gladiators'
  i16 team_type = 1
end

message 5270 ArenaTeamCreateAck
  ## Table case in 0x0049D180 -> 0x0049BEF0.
  u32 result
  i64 team_id = 1
  i16 team_type = 1
  i32 score = 1000
  i32 member_count = 1
  wstr team_name = 'Gladiators'
  wstr leader_name = 'Leader'
  wstr notice = 'Welcome to Arena Team'
end

message 5271 ArenaTeamJoinReq header?
  i64 team_id = 1
end

message 5272 ArenaTeamJoinAck
  ## Table case in 0x0049D180 -> 0x0049C4B0.
  u32 result
  i64 team_id = 1
  i16 team_type = 1
  i32 score = 1000
  i32 member_count = 2
  wstr team_name = 'Gladiators'
  wstr leader_name = 'Leader'
  wstr notice = 'Welcome to Arena Team'
end

message 5274 ArenaTeamLeaveReq header?
end

message 5275 ArenaTeamLeaveAck
  ## Table case in 0x0049D180 -> 0x00490100: result, 14 raw bytes.
  u32 result
  raw[14] _
end

struct LeagueRankEntry
  ## Ladder entry, 0x00475AA0 -> 0x00A4A120.
  u32 rank = 1
  u64 char_uid = 10001
  wstr char_name = 'Gladiator'
  u32 score = 1500
  u8 char_class = 1
  u8 char_level = 50
  u32 wins = 10
  u32 losses = 2
  u32 draws
  u32 rating = 1500
  u32 tier = 1
end

message 2550 LeagueSeasonArenaGetRankReq header?
  i32 season_id = 1
end

message 2551 LeagueSeasonArenaGetRankAck
  ## Case in 0x0049B230 -> 0x00499DC0: result, season, entries, 12-byte footer.
  u32 result
  i32 season_id = 1
  vector<LeagueRankEntry> ranks
  raw[12] _                  # footer
end

message 2552 LeagueSeasonArenaGetMyRankReq header?
  i32 season_id = 1
end

message 2553 LeagueSeasonArenaGetMyRankAck
  ## Table case in 0x0049D180 -> 0x00492A10.
  u32 result
  i32 my_rank = 1
end

message 2537 LeagueSeasonCharAwardNot
  ## Handler 0x007A22D0.
  i32 season_id
  map<?> _                   # awards (0x007682A0)
end

message 2538 LeagueSeasonGuildAwardNot
  ## Handler 0x007A2560.
  map<?> _                   # guild awards (0x007682A0)
end

message 2715 MinigameGbbStartReq header?
  ## Sender 0x007A8280 writes no fields (Rock-Paper-Scissors minigame).
end

message 2716 MinigameGbbStartAck
  ## Reply to 2715.
  u32 result
end

message 2717 GbbChallengeReq header?
  ## Sender 0x007A8300: choice (0/1/2).
  i16 choice
end

message 2718 GbbChallengeAck
  ## Reply to 2717.
  u32 result
  i16 server_choice
  i16 outcome
end

message 2719 GbbGiveupReq header?
  ## Sender 0x007A83A0 writes no fields.
end

message 2720 GbbGiveupAck
  ## Reply to 2719.
  u32 result
end

message 5135 ArenaSquareChangeRelayAddressNot
  ## Handler 0x0075AC00 (assert: *m_spArenaSquareP2PAddr, struct 0x00A48910).
  raw[24] _                  # P2P address struct
end

message 2472 ArenaRandomMatchingUserCntNot
  ## Handler 0x0048A7A0 (assert: m_vecSeasonRankTop >> m_jSeasonBeginTime).
  vector<?> _                # m_vecSeasonRankTop (0x00487F40)
  raw[12] season_begin_time
end

message 2556 LeagueSeasonArenaCharStatUpdateReq header?
  ## Update league arena season char stats -> 2557.
  map<wstr,i16> season_stat
end

message 2557 LeagueSeasonArenaCharStatUpdateAck ok_only
  ## Handler 0x00499980 (assert: jInfo.m_mapSeasonStat, map<wstr, i16> 0x00481110).
  u32 result
  map<wstr,i16> season_stat
end

message 2561 LeagueSeasonArenaCharStatInitReq header?
  ## Reset league arena season char stats -> 2562.
end

message 2562 LeagueSeasonArenaCharStatInitAck ok_only
  ## Handler 0x00492BF0 (assert: nCurAr >> nSeasonInitStatCnt).
  u32 result
  i64 cur_ar
  i32 season_init_stat_cnt
end

message 5140 ArenaLeaveSquareAck
  ## Handler 0x006A3C50 (reads u32 result only).
  u32 result
end

message 5141 ArenaLeaveLayerNot ok_only
  ## Handler 0x006A4370 (assert: nLeaveCharUID).
  u32 result
  i64 leave_char_uid
end

message 5142 ArenaJoinLayerReq header?
  ## Join arena square layer -> 5143.
  i64 layer_net_id
end

message 5143 ArenaJoinLayerAck ok_only
  ## Handler 0x006A3E50 (assert: nJoinArenaSquareUID >> nJoinLayerNetID >> nJoinSquareUID).
  u32 result
  i64 arena_square_uid
  i64 join_layer_net_id
  i64 join_square_uid
end

message 5144 ArenaJoinLayerNot
  ## Handler 0x006A4170 (assert: vecPageCharTemp).
  vector<PageCharTemp> players
end

message 5150 ArenaLeaveRoomNot ok_only
  ## Handler 0x004C3B50 (assert: jNot, struct 0x00A1E720: 14 raw bytes).
  u32 result
  raw[14] leave_info
end

message 5163 ArenaBanishUserReq header?
  ## Kick member from arena room -> 5164.
  i64 target_uid
end

message 5164 ArenaBanishUserAck ok_only
  ## Handler 0x004BBC80 (assert: jNot, struct 0x00A1E720: 14 raw bytes).
  u32 result
  raw[14] banish_info
end

message 5168 ArenaChangeRoomHostReq header?
  ## Change arena room host -> 5169.
  i64 new_host_uid
end

message 5169 ArenaChangeRoomHostAck ok_only
  ## Handler 0x004C40C0 (assert: nChangeNewHostUID).
  u32 result
  i64 new_host_uid
end

message 5172 ArenaStartGameReq header?
  ## Start arena match -> 5173.
end

message 5173 ArenaStartGameAck ok_only
  ## Handler 0x004C0160 (assert: nRandSync >> nPlayedMapID >> mapLearnSkill >> mapSubCharInfo >> mapQuickSlot >> mapLeagueArenaCharInfo >> mapProficiency).
  u32 result
  i32 rand_sync
  i32 played_map_id
  map<?> _                   # mapLearnSkill (0x004B8B80)
  map<?> _                   # mapSubCharInfo (0x004BA530)
  map<?> _                   # mapQuickSlot (0x004B7460)
  map<?> _                   # mapLeagueArenaCharInfo (0x0048B380)
  map<i64,vector<f32>> proficiencies  # mapProficiency (0x004B7550)
end

message 5182 ArenaReadyGameReq header?
  ## Toggle arena match ready -> 5183.
  bool is_ready = true
end

message 5183 ArenaReadyGameAck ok_only
  ## Handler 0x004C3F40 (assert: nCharUID >> bIsReady).
  u32 result
  i64 char_uid
  bool is_ready
end

message 5202 ArenaRandomMatchingRequestReq header?
  ## Queue for arena random matching -> 5203.
  i32 match_type = 1
end

message 5203 ArenaRandomMatchingRequestAck
  ## Handler 0x0049BC80 (reads u32 result only).
  u32 result
end

message 5220 ArenaRandomMatchingInitAck bare
  ## Handler 0x0049BE30 (empty body).
end

message 5226 ArenaSelectSubCharAck ok_only
  ## Handler 0x004C5CC0 (assert: nSessionUID >> jSubCharInfo, 0x00A49600).
  u32 result
  i64 session_uid
  RoomMemberInfo sub_char_info = RoomMemberInfo()
end

message 5265 ArenaChangeRoomCharInfoReq header?
  ## Change arena room team/ready -> 5266.
  i32 team_id
  bool is_ready
end

message 5266 ArenaChangeRoomCharInfoAck ok_only
  ## Handler 0x004C4A20 (assert: nCharUID >> nTeamID >> mapSlotInfo >> bIsReady).
  u32 result
  i64 char_uid
  i32 team_id
  map<?> _                   # mapSlotInfo (0x004AA240)
  bool is_ready
end

message 5267 ArenaChangeSlotCharInfoReq header?
  ## Change arena room slot -> 5268.
  i16 slot_idx
end

message 5268 ArenaChangeSlotCharInfoAck ok_only
  ## Handler 0x004C5010 (assert: m_spCurRoom->m_mapSlotInfo).
  u32 result
  map<?> _                   # m_mapSlotInfo (0x004AA240)
end

message 5276 ArenaTeamLeaveNot ok_only
  ## Handler 0x0049C110 (assert: jNotInfo, struct 0x00A1E720: 14 raw bytes).
  u32 result
  raw[14] not_info
end

message 5282 ArenaTeamBanishReq header?
  ## Kick member from arena team -> 5283.
  i64 target_uid
end

message 5283 ArenaTeamBanishAck ok_only
  ## Handler 0x00490320 (assert: jNotInfo, struct 0x00A1E720: 14 raw bytes).
  u32 result
  raw[14] not_info
end

message 5286 ArenaTeamChangeHostReq header?
  ## Change arena team leader -> 5287.
  i64 new_host_uid
end

message 5287 ArenaTeamChangeHostAck ok_only
  ## Handler 0x0049B050 (assert: nNewHostUID).
  u32 result
  i64 new_host_uid
end

message 5301 ArenaChangeTeamInfoReq header?
  ## Change arena team name/type -> 5302.
  i32 team_type
  wstr team_name
end

message 5302 ArenaChangeTeamInfoAck ok_only
  ## Handler 0x0049CBB0.
  u32 result
  i32 team_type
  wstr team_name
end
