# Personal shops (player stalls) and the broker marketplace. Format: schemas/README.md.
# These flows are synthetic (not confirmed with the client). The earlier encoders
# put 0x1E bytes before structs; 0x00B35010 consumes no byte for that tag, so
# they are not sent.

domain stalls Dark Blood protocol wire messages - Personal Shop (Player Stalls) and Broker (Marketplace).

extern Item from darkblood.games.entities.items

struct StallItem
  ## Item offered in a personal stall.
  Item item = Item()
  i64 price                  # AR price
end

struct StallOffer
  ## Element of the 2340 item vector (earlier server's guess).
  i64 item_uid
  i32 count = 1
  i64 price
end

message 2340 PersonalShopOpenReq header?
  ## No sender recovered; layout is the earlier guess.
  wstr title
  vector<StallOffer> items
end

message 2341 PersonalShopOpenAck ok_only
  ## Reader 0x00601AA0 -> 0x00A55D70: result, jPersonalShop, title. jPersonalShop:
  ## i64 owner, 6-byte address (0x00A48910, the 5002/5004 relay reader), item vector
  ## (0x00A554A0 -> 0x00A54550: Item + i64 price), vector<u32> (0x004D9610), then
  ## +0x2E 8 bytes, +0x36 u16, +0x38 u32, +0x3C bool, +0x3D 4 bytes (0x00B35560).
  ## The earlier layout sent a date in place of the address and a bool in place of
  ## the last 4 bytes, so the client read 3 bytes of the title as shop data.
  i32 result
  i64 owner_uid              # jPersonalShop +0x00
  raw[6] owner_address       # +0x08 IPv4 + u16 port (0x00A48910); zero = none
  vector<StallItem> items    # +0x0E
  vector<?> _                # +0x1E vector<u32> (0x004D9610), not recovered
  u64 _                      # +0x2E (0x00B356F0)
  u16 _                      # +0x36
  i32 expire_time = 86400    # +0x38 remaining seconds (earlier guess)
  bool _ = true              # +0x3C
  u32 _                      # +0x3D 4 bytes (0x00B35560)
  wstr title
end

message 2342 PersonalShopCloseReq header?
  i64 owner_uid
end

message 2343 PersonalShopCloseAck
  i32 result
  i64 owner_uid
end

message 5242 PersonalShopBuyReq header?
  i64 seller_uid
  i64 item_uid
  i32 count = 1
end

message 5243 PersonalShopBuyAck ok_only
  ## "vecItemOut >> jPersonalShop >> nCurrentAr".
  i32 result
  vector<Item> items         # vecItemOut: granted or updated for the buyer
  i64 seller_uid             # jPersonalShop (same layout as 2341)
  raw[6] seller_address      # +0x08 IPv4 + u16 port (0x00A48910)
  vector<StallItem> stall_items
  vector<?> _                # vector<u32> (0x004D9610)
  u64 _
  u16 _
  i32 expire_time = 86400
  bool _ = true
  u32 _                      # 4 bytes (0x00B35560)
  i64 gold                   # nCurrentAr
end

message 6021 PersonalShopGetProductsReq header?
  i64 seller_uid
end

message 6022 PersonalShopGetProductsAck ok_only
  i32 result
  i64 seller_uid
  wstr title
  vector<StallItem> items
  i32 expire_time = 86400
end

message 5250 PersonalShopChangeNot
  i64 seller_uid
  wstr title
  i32 item_count
end

message 5254 PersonalShopStartNot
  i64 seller_uid
  wstr title
end

message 5255 PersonalShopCloseNot
  i64 seller_uid
end

struct BrokerProduct
  ## Broker listing (earlier server's guess).
  Item item = Item()
  i64 price
  wstr seller_name
  i32 expire_time = 86400
  i64 unit_price
  i64 listing_id
end

message 2262 BrokerListReq header?
  i32 page
  i32 category
  wstr filter_name
end

message 2263 BrokerListAck ok_only
  ## Reader 0x005ADAC0.
  i32 result
  vector<BrokerProduct> products
  i32 page
  i32 total_count
end

message 2264 BrokerMyListReq header?
end

message 2265 BrokerMyListAck ok_only
  ## Reader 0x005ADFF0.
  i32 result
  vector<BrokerProduct> products
end

message 2266 BrokerRegistItemReq header?
  ## Live capture (2026-11-26): 16 bytes (i64 item_uid, i64 price), no header.
  i64 item_uid
  i64 price
end

message 2267 BrokerRegistItemAck ok_only
  ## Handler 0x005B06A0 -> reader 0x00A40460: i64 cur_ar, vector<Item>, vector<BrokerProduct>.
  i32 result
  i64 cur_ar
  vector<Item> items
  vector<BrokerProduct> my_products
end

message 2268 BrokerBuyItemReq header?
  ## Sender 0x005A8656: single i64 item_uid (8 bytes).
  i64 listing_id
end

message 2269 BrokerBuyItemAck ok_only
  ## Handler 0x005B0980 -> reader 0x00A1E7A0 (0x28 raw bytes): +0x00 i64 cur_ar (player+0x70), +0x08 i64 item_uid.
  i32 result
  i64 gold
  i64 item_uid
  raw[24] _
end

message 2270 BrokerCancelReq header?
  ## Sender 0x005A8236: single i64 item_uid (8 bytes).
  i64 listing_id
end

message 2271 BrokerCancelAck ok_only
  ## Handler 0x005AC9D0 (assert: iItemUID).
  i32 result
  i64 item_uid
end

message 2272 BrokerPriceReq header?
  i32 item_id
end

message 2273 BrokerPriceAck
  i32 result
  i64 avg_price
  i64 min_price
end

message 2398 BrokerChangeRegistCountNot
  ## Handler 0x0077B2D0 (assert: sIncrBrokerCount >> nIncrBrokerRemainExpireTime >> tIncrBrokerExpireTime).
  i16 incr_broker_count
  i64 remain_expire_time
  i64 expire_time
end

message 2586 SaleByBulkOptionReq header?
  ## Sender 0x007A4930 (assert: sEquipIdx << bEnable).
  i16 equip_idx
  bool enable
end

message 2587 SaleByBulkOptionAck ok_only
  ## Handler 0x0076CBD0 (assert: mapSellEquipinfo, map<i16, bool> reader 0x00765870).
  i32 result
  map<i16,bool> sell_equip_info
end

message 2588 SaleByBulkRegistReq header?
  ## Sender 0x007A4A70 (assert: nRegItemID << bIsAdd).
  i32 reg_item_id
  bool is_add
end

message 2589 SaleByBulkRegistAck ok_only
  ## Handler 0x007725D0 (assert: vecCustomItemList, vector<i32> reader 0x004D6E60).
  i32 result
  vector<i32> custom_item_list
end
