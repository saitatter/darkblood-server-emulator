# Mailbox (post) messages. Format: schemas/README.md.

domain mail Mailbox wire messages (eEGS_POST_*).

extern Item from darkblood.games.entities.items

struct PostEntry
  ## Mail header and payload (deserializer 0x00A55920, 0x8C bytes in memory).
  ## The 0x1E struct check in the reader consumes no wire byte, so no tag is written.
  i64 uid                    # +0x00
  u8 post_type               # +0x08: 0 normal, 1 system, 2 returned
  i64 sender_uid             # +0x09
  bool is_read               # +0x11
  bool has_item              # +0x12
  bool can_return = true     # +0x13
  i32 remain_days = 30       # +0x14
  i64 gold                   # +0x18
  i64 send_time              # +0x20
  wstr sender_name           # +0x28
  wstr title                 # +0x44
  wstr content               # +0x60
  vector<Item> items         # +0x7C
end

message 2219 PostListReq header
  ## Sender 0x00796270. Observed live body: ffffff7f 00.
  bool flag                  # 0x00B35630 argument; meaning unknown
end

message 2220 PostListAck ok_only
  ## Handler 0x007AEF70. Map values are read by 0x00784F30.
  u32 result
  map<i64,PostEntry> inbox   # key = mail uid
  map<i64,PostEntry> outbox  # key = mail uid
  u32 unread_count
  bool notify
end

message 2221 PostSendReq header?
  ## Sender 0x00795D40.
  wstr recipient
  wstr title
  vector<i64> items          # attached item uids (0x004CB5E0)
  i64 gold                   # attached gold
  i64 extra                  # COD price
  bool is_cod
end

message 2222 PostSendAck ok_only
  ## Handler 0x00795F40.
  i32 result
  vector<Item> items         # updated inventory items
  i64 remain_gold
  i16 daily_send_count = 1
  i16 max_daily_send_count = 30
end

message 2223 PostReadReq header?
  ## Sender 0x00796390.
  i64 mail_uid
end

message 2224 PostReadAck
  ## Handler 0x0075A660.
  i32 result
  i64 mail_uid
end

message 2225 PostGetAppendItemReq header?
  ## Sender 0x007965F0.
  i64 mail_uid
  rest item_record           # item record written by 0x00A4FAA0; not decoded
end

message 2226 PostGetAppendItemAck ok_only
  ## Handler 0x0077F8E0.
  i32 result
  i64 mail_uid
  i64 gold
  vector<Item> items
end

message 2227 PostNewArrivalNot bare
  ## Handler 0x007965B0. Sent as an empty body; whether the handler reads a
  ## result word is unverified.
end

message 2234 PostReturnReq header?
  ## No sender recovered in research/opcode_xrefs.tsv (call site near 0x00A33907).
  i64 mail_id
end

message 2235 PostReturnAck ok_only
  ## Handler 0x00771470.
  i32 result
  vector<i64> mail_uids
end

message 2236 PostDeleteReq header?
  ## Sender 0x00796470: header, then tag 0x10 vector (0x004CB5E0).
  vector<i64> mail_uids
end

message 2237 PostDeleteAck ok_only
  ## Handler 0x007715F0.
  i32 result
  vector<i64> mail_uids
end
