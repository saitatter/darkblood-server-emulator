# Fishing system messages. Format: schemas/README.md.

domain fishing Dark Blood protocol wire messages - Fishing domain.

extern Item from darkblood.games.entities.items

message 2523 FishingStartReq header?
  ## Sender 0x007A1FF0 (struct writer 0x00A1EE20), called from the fishing page
  ## start 0x005421C0 with the target's id string (+8 of the page's target, e.g.
  ## "Fish_ACT1_N0") and the ItemID of the page's slots 4 and 5. Before sending, the
  ## page refuses outside a town (UI_2950), without the hole's license (UI_2952) and
  ## with a full inventory (UI_227).
  wstr fishing_hole_id       # live: "Fish_ACT1_N0"
  h32 hole_hash              # live: jhash(fishing_hole_id)
  h32 bait_item_id           # live: jhash("ILurN1") from the page's Bait slot (Type 45 items)
  i32 boost_item_id = -1     # live: -1 with the optional Boost slot empty (assumed: the Boost item's ItemID)
end

message 2524 FishingStartAck
  ## Handler 0x0075B0B0 (reads u32 result only).
  i32 result
end

message 2525 FishingStopReq header?
  ## Sender 0x007A21E0 writes no fields.
end

message 2526 FishingStopAck
  ## Handler 0x0075B1C0 (reads u32 result only).
  i32 result
end

message 2527 FishingResultNot
  ## Handler 0x00782020 (assert: vecItemOut >> bLicenseTime). Both fields are read
  ## whatever the result (not ok_only), so a miss still carries the bait update. result 0 plays the catch
  ## motion 0x41; nonzero plays 0x40 and shows JERI_FISHING_05 "You didn't catch anything."
  ## The items go to the fishing page (0x00542570).
  i32 result
  vector<Item> items
  bool license_time
end

message 2528 FishingFailedNot
  ## Handler 0x00776310 (reads u32 result only).
  i32 result
end

message 2529 FishingProficiencyNot ok_only
  ## Handler 0x00776400 (assert: fProficiency >> iProficiencyType).
  i32 result
  f32 proficiency
  i32 proficiency_type
end

message 2541 FishingLicenseChangeNot ok_only
  ## Handler 0x0075B2E0 (assert: nFishingHoleID >> nRemainTime >> nItemID).
  i32 result
  i32 fishing_hole_id
  i64 remain_time
  i32 item_id
end

message 2542 FishingLicenseExpireNot
  ## Handler 0x0075B480 (assert: nExpireFishingHoleID).
  i32 expire_fishing_hole_id
end
