# Roulette, NPC first meet, teaching, treasure, citadel and gold goblin events.
# Format: schemas/README.md.

domain events Dark Blood protocol wire messages - Events domain.

extern Item from darkblood.games.entities.items

message 2391 RouletteManagerInfoAck
  ## JAppPageRoulette::OneEGS_ROULETTE_MANAGER_INFO_ACK (0x0062CBC0):
  ## No result u32; implicit struct 0x1E (no wire tag) + 0x0D raw bytes (0x00A1E7E0).
  ## +0x00 i32 manager_id, +0x04 bool active, +0x05 i64 jackpot_ar (stored at +0x1C0).
  i32 manager_id = 1
  bool active = true
  i64 jackpot_ar = 1000000
end

message 2095 NpcFirstMeetAck
  ## Reader 0x00752B60.
  u32 result
  u32 npc_id
end

message 5351 RequestTeachingReq
  i64 target_uid
end

message 5352 RequestTeachingAck
  ## Handler 0x0075C200 (assert: nRequestCharUID >> strRequestCharNick >> ucLevel >>
  ## ucJob >> bNovice).
  i32 result
  i64 target_uid             # nRequestCharUID
  wstr target_name           # strRequestCharNick
  u8 level                   # ucLevel
  u8 job                     # ucJob
  bool novice = true         # bNovice
end

message 5353 AcceptRequestTeachingReq
  i64 mentor_uid
end

message 5354 AcceptRequestTeachingAck
  ## Handler 0x0075C430.
  i32 result
  bool accepted = true
  i64 mentor_uid
  wstr mentor_name
end

message 5355 TeachingGetInfoNot
  ## Handler 0x007A5890. Layout not recovered; 32 zero bytes by default.
  raw[32] info_payload
end

message 5344 TreasureStartNot
  ## Handler 0x007722F0.
  i32 result
end

message 5345 TreasureEndNot
  ## Handler 0x0075BC00.
  i32 result
end

message 5346 CitadelRewardNot
  ## Handler 0x007833F0 (assert: mapCitadelRewardItemUnit >> vecItem).
  i32 result
  map<?> _                   # mapCitadelRewardItemUnit (0x0077BFB0 -> 0x0076F040), layout not recovered
  vector<Item> items
end

message 5362 GoldGoblinAppearNot
  ## Handler 0x007A6D10 (assert: nWarflagSlotID >> vecMonID).
  i32 goblin_id = 1          # nWarflagSlotID
  vector<u32> monster_ids    # vecMonID (0x004D6E60, u32 elements)
end

message 5363 GoldGoblinAttackReq
  i32 goblin_id = 1
  i32 damage = 100
end

message 5364 GoldGoblinAttackAck
  ## Handler 0x00784A10.
  i32 result
end

message 5365 GoldGoblinDeadReq
  i32 goblin_id = 1
end

message 5366 GoldGoblinDeadAck
  ## Handler 0x00784CA0 (assert: nDeadMobID >> iLayerID >> fX >> fY >> vecDropItem).
  ## The earlier layout sent two i16 where the client reads two 4-byte floats.
  i32 result
  i32 goblin_id = 1          # nDeadMobID
  i32 layer_id               # iLayerID
  f32 x                      # fX
  f32 y                      # fY
  vector<Item> items         # vecDropItem (0x004D5C70; element layout not re-checked)
end

message 5367 GoldGoblinDisappearNot
  i32 goblin_id = 1
end
