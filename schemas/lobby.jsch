# Server/channel lists, character selection, squares and relay. Format: schemas/README.md.

domain lobby Dark Blood protocol wire messages - Lobby domain.

extern Character from darkblood.games.entities.character encode=encode_world_details
extern Bag from darkblood.games.entities.items
extern Item from darkblood.games.entities.items
extern ActiveQuest from darkblood.games.missions.quests encode=encode_entry
extern LearnedSkill from darkblood.games.network.messages.skills
extern QuickSlot from darkblood.games.network.messages.skills
extern WaypointData from darkblood.games.network.messages.quests
extern QuestSpecialInfo from darkblood.games.network.messages.quests
extern RidingInfo from darkblood.games.network.messages.pets
extern PetInfo from darkblood.games.network.messages.pets
extern AchieveEntry from darkblood.games.network.messages.system readable
import layer_net_id from darkblood.games.entities.character

struct GameServer
  ## Server List entry of 2403 (reader 0x00A496B0, constructor 0x0074DF70).
  wstr name = 'Offline'
  u16 u16                    # meaning unknown
  u64 u64                    # meaning unknown
  bool flag_a                # meaning unknown
  bool flag_b                # meaning unknown
  bool flag_c = true         # meaning unknown
end

struct ChannelSquare
  ## Channel List entry of 2022 (reader 0x00A49700).
  u64 square_id = 1
  wstr name = 'Channel 1'
  u32 a                      # meaning unknown
  u32 load = 100             # 100 = "Normal · [Good]" in the UI
  u32 c                      # meaning unknown
end

struct DepotSlotInfo
  ## Extended storage tab info (reader 0x00A1EBF0, 0x13 bytes on wire, 0x1B in memory).
  ## 0x00942EE0 converts remain_sec to expiry ms; 0x00936990 indexes slots[0..1]
  ## for storage groups 2 and 3 (group 1 = slots 0..19 is always unlocked).
  bool active
  u16 slot_index = 0xFFFF
  u64 expire_date
  i64 remain_sec
end

struct PetDepotSlotInfo
  ## Extended pet-storage tab info in 2007 (reader 0x00A1E820 -> 0x00B35760(0x1B)).
  ## Unlike 0x00A1EBF0 (field-by-field, 0x13 bytes), 0x00A1E820 reads the full
  ## 0x1B-byte (27-byte) packed struct verbatim after the 0x1E struct tag.
  bool active
  u16 slot_index = 0xFFFF
  u64 expire_date
  i64 remain_sec
  u64 _
end

struct DepotInfo
  ## Per-character depot record in 2007 map 0x00A40720 (reader 0x00A40380).
  i64 char_uid               # +0x00 m_nCharUID (passed to 2036 DragItemReq on storage drop)
  i64 gold                   # +0x08 m_nAr (displayed in Page_Storage depot_ar)
  wstr char_name             # +0x10 m_strCharName (shown in Page_Storage char_division)
  vector<Item> items         # +0x2C stored items (container=2, owner=char_uid)
  vector<DepotSlotInfo> slots # +0x3C MUST contain 2 entries (groups 2 & 3)
  u64 share_expire_time      # +0x4C shared depot expiration
  i64 _                      # +0x54 unknown
end

message 2002 KnockSquareListAck
  ## Handler 0x00757810 (reply to 2001); the server sends only the result.
  u32 result
end

message 2017 EnterMaptoolAck
  ## Handler 0x00757D20 (reply to 2016); the server sends only the result.
  u32 result
end

message 2007 SelectCharacterAck ok_only
  ## Handler 0x007AA4B0: untagged struct 0x00A40760 starting with the result (the
  ## handler peeks it with 0x00A1EA20(1) and the reader rereads the same word),
  ## nested character details (0x00A52630), then the fields below. Field
  ## meanings are unknown unless commented; they are sent as zero or empty. +0xNNN are
  ## offsets in the reader's struct; consumers were traced in the handler's assembly
  ## (esp-tracked, checked against the bag/item/depot/count/waypoint/pet anchors).
  u32 result
  array<?> _                 # 0x00A3ED30, max 3
  array<f32> proficiencies   # 0x00A1E840 (+0x395 -> JProficiencyMgr::Init 0x00AC9BD0, 10 floats)
  Character character = Character()
  u64 _
  u64 _
  u64 _
  u64 _
  u8 _
  u8 _
  map<i64,DepotInfo> depots  # 0x00A40720 -> 0x00A40590 -> 0x00A40380, consumed by JDepotMgr 0x00942EE0
  vector<Bag> bags           # 0x00558010 (+0x293), consumed by 0x00837D60 -> 0x00836010
  vector<Item> items         # 0x004B9830 (+0x2A3), inserted by 0x00835990 after the bags
  vector<QuickSlot> quickslots  # 0x004B2C30 (+0x2B3)
  vector<?> _                # 0x00A3EEC0
  map<u16,LearnedSkill> skills  # 0x004B1240, element reader 0x004ACB80 (as 2698)
  map<?> _                   # 0x0076E560
  set<wstr> cleared_maps     # 0x0076A8C0 -> 0x00765450 (set of map codes)
  map<?> _                   # 0x00A3E410
  u64 _
  u32 _
  u32 _
  pairs<ActiveQuest> active_quests  # 0x00A3E450 (0x00A209B0); same map 2074 fills via 0x00A60960
  set<u32> u32_set_a         # 0x005EE0F0
  QuestSpecialInfo quest_special_info = QuestSpecialInfo()  # 0x00641E00 -> JQuestMgr::Init (restores TempSkillSet on relog)
  set<u32> u32_set_b         # 0x005EE0F0
  u64 _
  u64 _
  u64 _
  u32 pcbang_coin_remain     # +0x217 -> AppPage(0x12).0x0054A1E0, the same setter as 2449
  u64 _
  u64 _
  vector<?> _                # 0x004B1A60
  u64 _                      # +0x255 -> JGuildManager (singleton 0x0049F7F0) +0xC4
  bool _
  bool _
  f32 _                      # +0x3BD -> player +0xB0
  i64 _                      # +0x3C1 -> player 0x009465D0: seconds, end = now_ms + s*1000 at player +0xC0
  u64 _
  map<wstr,i16> daily_dun_enter_counts  # 0x00485220 (+0x3D1 -> 0x009646F0)
  map<wstr,i16> daily_dun_clear_counts  # 0x00485220 (+0x3DD -> 0x00964A00)
  wstr custom_keys           # 0x00B35AB0 (+0x25D -> 0x0045FCF0 custom keyboard bindings)
  map<u32,i64> achieve_divisions  # +0x3EB jAchieveTotalInfo (0x0074C1D0 -> 0x00A3E760, as 2328) -> AppPage(0x6B).0x00481760
  map<h32,AchieveEntry> achieve_completed  # +0x3F7 (0x00A3DC50)
  bool _                     # +0x403, read but unused by 0x00481760 (as in 2328)
  map<u64,WaypointData> waypoints  # 0x00A3EA00 -> 0x00A3E490 -> 0x00A1F4E0 (u64 + WaypointData)
  u64 _
  i64 personal_store_expire_sec  # +0x40C JAppPagePersonalStore::SetExpire (0x00603130): expiry = _time64 + this
  u32 _                      # +0x414 first SetExpire argument, only logged
  vector<u32> learned_proficiencies  # 0x004DA660 (+0x418 -> JProficiencyMgr::Init 0x00AC9BD0, max 2 chosen prof types 0..6)
  vector<u32> cash_items     # +0x428 vecCashItemOut: Premium inventory ProductIDs (0x004DA660 -> 0x004D9610 -> 0x004D6E60), handler passes it to 0x00830300 (0x007AA85D)
  u16 _                      # +0x438 -> JAppPageInitLifeSkill (AppPage 0x46) +0x120 via 0x005A3FE0
  i64 life_skill_init_remain_sec  # +0x43A -> 0x005A3FE0: +0x118 = _time64 + this (read back by 0x005A4020)
  u64 _
  map<u32,set<u32>> buff_map_a  # 0x005F9190 -> 0x005F6640
  map<h32,RidingInfo> ridings   # 0x0076ABA0 -> 0x00768250 -> 0x007656E0 (unlocked mounts)
  map<i64,PetInfo> pets      # 0x00A1E8C0 -> 0x00A54E70 -> 0x0064EA00 -> 0x00643940 -> 0x00A52CF0
  i64 summoned_pet_uid       # +0x0C active summoned pet UID (0 if none)
  bool pet_summoned          # +0x14 whether a pet is currently summoned
  u64 _                      # +0x15 unknown
  vector<PetDepotSlotInfo> pet_depot_slots  # 0x00A3EDD0 -> 0x00A3E920 -> 0x00A1E820 (Page_Pet +0x23C, 0x1B bytes each)
  u32 _                      # +0x48F 0x00A1EEA0: u32, 3 x u64 -> AppPage(0x8A).0x00529110
  u64 _
  u64 _
  u64 _
  map<?> _                   # +0x303 0x00A1E900: map + vector -> AppPage(0x2A).0x0058DFB0
  vector<?> _
  u16 monster_card_add_slots  # +0x4AB -> AppPage(0x93).0x005DE1B0: BaseSlotCount(60) + this
  vector<u32> u32_vec_c      # 0x004DA660
  map<u32,set<u32>> buff_map_b  # 0x005F9150 -> 0x005F6640
  i16 citadel_play_count     # 0x00B351E0 (+0x3E9 -> player +0x304, UI_3408 Left Challenge Opportunity)
  map<?> _                   # +0x4C9 0x00485220: map<wstr,i16> (as the daily counts) -> 0x00F45E18.0x006B6640
  vector<Item> insert_items  # vecInsertItem (assert 0x007AA4B0: jAck >> vecInsertItem; 0x004B9210)
end

message 5029 JoinSquareAck
  ## Reader 0x00757AD0.
  u32 result
  u64 square_id = 1
end

message 5134 RelayAddressNot
  ## Reader 0x0075AAE0: implicit 0x1E struct = 6 raw bytes (0x00A48910) written to
  ## the relay buffer; the handler then calls JP2PClient::Connect (0x00956C80).
  ipv4 ip = '127.0.0.1'      # network byte order
  u16 port = 9401
end

message 5046 BackToSquareAck
  ## Handler 0x007897F0; names from "nJoinSquareUID >> nJoinLayerNetID >>
  ## vecTargetState >> bUseWaypoint >> iCurAr". Outside SquarePlay the handler
  ## validates the layer id like CanEnter, stores it at player+0xF0, changes to
  ## eAS_SquarePlay and reconnects the relay.
  u32 result
  u64 square_uid = 1
  u64 layer_net_id = layer_net_id()
  vector<?> _                # vecTargetState (0x00773870), element layout unknown
  bool use_waypoint
  i64 cur_ar                 # iCurAr: current AR; 0 showed 0 AR in town until relog
end

struct RelayJoinGroupAck
  ## ProudNet relay RMI 3001 JoinGroupACK (relay PIDL), not a JEvent.
  lit 0003
  u16 _ = 3001               # RMI id
  u32 group_host_id = 0x10000
end

struct PageCharTemp
  ## Player entry of 5027 (reader 0x00A494B0, writer 0x00A49530).
  i64 char_id
  f32 x
  f32 y
  f32 z
  wstr name
  u8 char_class = 1
  i64 level = 1
  i64 guild_uid
  wstr guild_name
  u64 server_bits            # server-list key in bits 54-58 (0x00A614A0): key << 54
end

message 5027 JoinLayerNot
  ## Handler 0x00787790: vecPageCharTemp, vecDuel. Spawns players in the town layer.
  vector<PageCharTemp> players
  vector<?> _                # vecDuel
end

message 2014 DeleteCharacterReq header
  ## Live: ffffff7f 0200000000000000 deletes character 2.
  i64 char_uid               # nDelCharUID
end

message 2015 DeleteCharacterAck
  ## On_eEGS_DELETE_CHARACTER_ACK 0x00758370.
  i32 result
  i64 char_uid               # nDelCharUID
  i32 complete_time          # nUserDelCompleteTime (0 = instant)
end

message 2244 CheatSystemDeleteCharacterReq header?
  ## Live: ffffff7f 0800000000000000 (Instant Delete button on character select).
  i64 char_uid               # nDelCharUID
end

message 2245 CheatSystemDeleteCharacterAck ok_only
  ## Handler 0x0075A9C0: reads u32 result; if 0 reads i64 char_uid and removes slot immediately.
  u32 result
  i64 char_uid
end

message 2247 UndeleteCharacterAck
  ## Handler 0x0075A8A0. Result 0 clears the pending deletion of that slot
  ## (0x006F02E0 with flag 0, time 0). Request 2246 has the same body as 2014.
  i32 result
  i64 char_uid
end

message 5165 ArenaBackToSquareReq bare
end

message 5166 ArenaBackToSquareAck
  ## Handler 0x00758550.
  i32 result
end

message 2323 CharNickChangeByIntegrateReq header?
  ## Sender 0x00798EC0.
  i64 char_uid
  wstr old_nick
  wstr new_nick
end

message 2324 CharNickChangeByIntegrateAck ok_only
  ## Handler 0x0075AD10 (assert: nCharUID >> strNewNick).
  u32 result
  i64 char_uid
  wstr new_nick
end

message 2404 EventDeleteCharacterReq header?
  ## Sender 0x0079AAC0.
  i64 char_uid
end

message 2405 EventDeleteCharacterAck ok_only
  ## Handler 0x0075AF00 (assert: nDeleteCharUID).
  u32 result
  i64 delete_char_uid
end

message 2441 CharSlotExtendReq header?
  ## Sender 0x0079CF70.
  i64 item_uid
end

message 2442 CharSlotExtendAck ok_only
  ## Handler 0x00781000 (assert: ucLimitCreateChar >> vecOutItem).
  u32 result
  u8 limit_create_char = 6
  vector<Item> items
end

message 5128 ImpliedJoinLayerReq header?
  ## Sender 0x00797480 -> replies with 5031 JoinLayerAck.
  i64 layer_net_id
  bool flag
end

message 5033 LeaveSquareAck
  ## Handler 0x00757960 (reads u32 result only).
  u32 result
end

message 5038 LeaveLayerAck
  ## Handler 0x007895C0 (reads u32 result only).
  u32 result
end

message 5039 LeaveLayerNot
  ## Handler 0x00789450: u32 result, i64 char_uid.
  u32 result
  i64 char_uid
end
