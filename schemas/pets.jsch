# Taming, riding and pet lifecycle. Format: schemas/README.md.
# Senders without 0x00A1E620 and without writer calls (2468, 2470, 2484) send an
# empty body, like the captured 2131/2390/2402/5045 requests.
# Replies whose element layout is unknown send empty containers. Earlier
# encoders wrote the list length without elements, which is not valid JSer.

domain pets Dark Blood protocol wire messages - Pet, Mount and Taming domain.

extern Item from darkblood.games.entities.items
extern DateTime6 from darkblood.games.network.messages.commerce readable

message 2348 TameingMonsterInsertReq header?
  ## Sender 0x00799BA0 writes a struct (0x00A48AB0) and a 4-byte value; the two
  ## i32 below are the earlier guess and are not confirmed.
  i32 monster_id
  i32 slot
end

struct TamedMonster
  ## 8-byte element of vecTameingList (0x0076AF20 -> 0x0083FDB0 -> 0x00A48AD0 raw 8),
  ## the same struct the 2348 sender writes with 0x00A48AB0. The split into two i32
  ## follows the request's earlier guess and is not confirmed.
  i32 monster_id
  i32 slot
end

message 2349 TamingMonsterInsertAck
  ## Handler 0x00771A00 (assert: vecTameingList).
  u32 result
  vector<TamedMonster> tamed  # vecTameingList: the character's full list
end

message 2350 TameingMonsterDeleteReq header?
  ## Sender 0x00799D30: two 4-byte values (0x00B352B0).
  i32 monster_id
  i32 slot
end

message 2351 TamingMonsterDeleteAck
  ## Handler 0x00771BB0 (assert: vecTameingList >> nMonsterID).
  u32 result
  vector<TamedMonster> tamed  # vecTameingList: the list after the deletion
  u32 monster_id             # nMonsterID
end

struct RidingInfo
  ## Mount record 0x00A4BD80 (40 bytes, used by 2007, 2435, 2436, 2647).
  array<raw[10]> dye_colors  # +0x0C (0x00A4B250, up to 2 x 10-byte dye blocks)
  h32 riding_id              # +0x00 (jhash("ridecall2"), matches riding.lua ID)
  i64 remain_sec             # +0x04 remaining seconds (> 0; 0 triggers dismount in 2436)
  u64 expire_date            # +0x20 expiration timestamp
end

message 2434 RidingGetListReq header?
  ## No sender recovered; no fields known.
end

message 2435 RidingGetListAck ok_only
  ## Handler 0x0076C5A0 (reader 0x007656E0).
  u32 result
  map<h32,RidingInfo> ridings  # mapRidingInfo (0x007656E0)
end

message 2437 RidingRideObjectReq header?
  ## Sender 0x0079CDE0: one 4-byte value.
  u32 ride_object_id
end

message 2438 RidingRideObjectAck ok_only
  ## Handler 0x00753A90.
  u32 result
  u32 ride_object_id
end

struct PetInfo
  ## Pet record 0x00A52CF0 (ctor 0x005014D0, used by 2465 PetCreateAck).
  array<raw[10]> dye_colors  # +0x42 (0x00A4B250, up to 2 x 10-byte dye blocks)
  i64 pet_uid = -1           # +0x00
  h32 pet_id = 0xFFFFFFFF    # +0x08 (jhash("PetCall001"))
  u8 level = 1               # +0x0C
  i32 exp                    # +0x0D
  i16 satiety = 100          # +0x11
  wstr name                  # +0x15
  vector<u16> skills         # +0x31 pet skill indices (0x0076E600 -> 0x0076D610, u16 elements)
  bool is_cash_food          # +0x41
  i16 slot = -1              # +0x13 (pet depot slot; -1 = active nurture slot)
end

message 2464 PetCreateReq header?
  ## Sender 0x0079E090: item UID of the Pet Egg being hatched.
  i64 pet_uid
end

message 2465 PetCreateAck ok_only
  ## Handler 0x0079E620 (assert 0x00CFD628: vecItem >> nItemID >> jNewPetInfo).
  ## Updates inventory (vecItem), registers jNewPetInfo (0x00A52CF0), refreshes
  ## UI [0, 7, 0x15], and opens page 0x7C (Pet window).
  u32 result
  vector<Item> items         # vecItem (consumed Pet Egg tombstone)
  h32 item_id                # nItemID (jhash of consumed Pet Egg code)
  PetInfo pet = PetInfo()    # jNewPetInfo (0x00A52CF0)
end

message 2466 PetDeleteReq header?
  ## Sender 0x0079E200.
  i64 pet_uid
end

message 2467 PetDeleteAck ok_only
  ## Handler 0x0079EA50.
  u32 result
  i64 pet_uid
end

message 2468 PetSummonReq bare
  ## Sender 0x0079E3C0 writes no fields.
end

message 2469 PetSummonAck ok_only
  ## Handler 0x0079ECF0 (assert 0x00CFD7A0: sNurturePoint).
  ## Updates active pet's sNurturePoint (0x009524F0), sets user+0x31C = 1,
  ## and broadcasts UI/peer refresh [0x13].
  u32 result
  u16 satiety = 100          # sNurturePoint (0x0079ECF0)
end

message 2470 PetReleaseSummonReq bare
  ## Sender 0x0079E4F0 writes no fields.
end

message 2471 PetReleaseSummonAck
  ## Handler 0x0079EEE0.
  u32 result
end

message 2473 PetSaveReq header?
  ## Sender 0x0079F1E0: one 2-byte value (0x00B35190).
  u16 value                  # meaning unknown
end

message 2474 PetSaveAck ok_only
  ## Handler 0x007758B0.
  u32 result
  u16 value                  # meaning unknown
end

message 2475 PetLoadReq header?
  ## Sender 0x0079F300.
  i64 pet_uid
end

message 2476 PetLoadAck ok_only
  ## Handler 0x0079F560.
  u32 result
  i64 pet_uid
end

message 2477 PetReplaceReq header?
  ## Sender 0x0079F430.
  i64 pet_uid
end

message 2478 PetReplaceAck ok_only
  ## Handler 0x0079F770.
  u32 result
  i64 pet_uid
end

message 2480 PetEatNormalReq header?
  ## Sender 0x0079FB80.
  i64 item_uid
end

message 2481 PetEatNormalAck ok_only
  ## Handler 0x00781260 (assert 0x00CF6938: vecItem >> sNurturePetSatiety >> bCashFood).
  u32 result
  vector<Item> items         # vecItem (0x004B9210): updated food item stacks
  u16 satiety = 100          # sNurturePetSatiety
  bool cash_food             # bCashFood
end

message 2484 PetEvolutionReq bare
  ## Sender 0x0079FE00 writes no fields.
end

message 2485 PetEvolutionAck ok_only
  ## Handler 0x0079FEF0 (assert 0x00CFDCA8: nPetUID >> nNewPetID >> vecSkill >> nCurAr).
  u32 result
  i64 old_pet_uid            # nPetUID
  u32 new_pet_id             # nNewPetID
  vector<u16> skills         # vecSkill (0x0076D610, u16 skill indices)
  i64 cur_ar                 # nCurAr: the player's AR after the evolution cost (was sent as a pet UID)
end

message 2510 PetNickChangeReq header?
  ## Sender 0x007A16B0.
  i64 pet_uid
  wstr new_name
end

message 2511 PetNickChangeAck ok_only
  ## Handler 0x00781CD0 (client name eEGS_PET_NICK_CHANGE_AKC; assert 0x00CF6B70:
  ## vecItemOut >> nPetUID >> strNewNick).
  u32 result
  vector<Item> items_out     # vecItemOut (0x004B9210): consumed rename item updates
  i64 pet_uid
  wstr new_name
end

message 2436 RidingChangeListNot
  ## Handler 0x0079C9A0 (assert: mapRidingInfo, reader 0x007656E0).
  map<h32,RidingInfo> ridings  # mapRidingInfo (0x007656E0)
end

message 2479 PetConsumeSatietyNot
  ## Handler 0x0079F980 (assert: nPetUID >> sConsumeSatiety).
  i64 pet_uid
  i16 consume_satiety
end

message 2482 PetEatCashReq header?
  ## Sender 0x0079FCC0.
  i64 item_uid
end

message 2483 PetEatCashAck ok_only
  ## Handler 0x007815F0 (assert: vecItem >> sNurturePetSatiety >> bCashFood).
  u32 result
  vector<Item> items
  i16 satiety = 100
  bool is_cash_food = true
end

message 2492 PetCashFoodEquipReq header?
  ## Sender 0x007A07C0.
  i64 cash_food_item_uid
end

message 2493 PetCashFoodEquipAck ok_only
  ## Handler 0x007A0A20 (assert: nCashFoodItemUID).
  u32 result
  i64 cash_food_item_uid
end

message 2494 PetCashFoodUnequipReq header?
  ## Sender 0x007A0930 writes no fields.
end

message 2495 PetCashFoodUnequipAck
  ## Handler 0x007A0C30 (reads u32 result only).
  u32 result
end

message 2498 PetExtendDepotReq header?
  ## Sender 0x007A1030.
  i64 item_uid
  i16 depot_slot_index
end

message 2499 PetExtendDepotAck ok_only
  ## Handler 0x00781990 (assert: sDepotSlotIndex >> nExtendTime >> vecOutItem).
  u32 result
  i16 depot_slot_index
  i64 extend_time
  vector<Item> items
end

message 2500 PetSwitchStorageReq header?
  ## Sender 0x007A0D00.
  i16 move_slot_index
  i16 target_slot_index
end

message 2501 PetSwitchStorageAck ok_only
  ## Handler 0x007A0E30 (assert: sMoveSlotIndex >> sTargetSlotIndex).
  u32 result
  i16 move_slot_index
  i16 target_slot_index
end

message 2502 PetDepotExtendExpireNot
  ## Handler 0x00775EA0 (assert: sPetDepotIndex).
  i16 pet_depot_index
end

message 2516 PetDyeingNot
  ## Handler 0x00776080 (assert: jResultPetInfo, reader 0x00A52CF0).
  array<raw[10]> dye_colors  # 0x00A4B250 (up to 2 x 10-byte dye blocks)
  i64 pet_uid
  i32 pet_id
  u8 level = 1
  i32 exp
  i16 satiety = 100
  wstr name
  vector<u16> skills         # 0x0076E600 -> 0x0076D610: pet skill indices (u16)
  bool is_summoned
  i16 status
end

message 2646 RidingExpireUpdateReq header?
  ## Sender 0x007A6530 (assert: nItemUID << iRidingID).
  i64 item_uid
  h32 riding_id
end

message 2647 RidingExpireUpdateAck ok_only
  ## Handler 0x007839F0 (assert: mapRidinglist >> vecOutItem).
  u32 result
  map<h32,RidingInfo> ridings  # mapRidinglist (0x007656E0)
  vector<Item> items
end

message 5323 PetLevelUpNot
  ## Handler 0x007754E0 (assert: jNot, reader 0x00A48B80: 21 raw bytes).
  raw[21] level_up_info
end

message 5324 PetChangeExpNot
  ## Handler 0x0079EFA0 (assert: nPetUID >> nChangeExp >> jGainExp, 0x00A49E20).
  i64 pet_uid
  i32 change_exp
  i32 gain_0
  i32 gain_1
  i32 gain_2
  i32 gain_3
  i32 gain_4
  i32 gain_5
  i32 gain_6
  i32 gain_7
  wstr text
end

struct MonsterCardInfo
  ## Monster card record, reader 0x00A52DB0 (2614).
  i64 card_uid
  h32 card_id
  i16 level = 1
  i64 owner_uid
  DateTime6 expire_time = DateTime6()  # 0x1E + 0x00A49110 (6 x u16)
  vector<?> _                # 0x004B0BB0 card options
end

struct MonsterCardLottoEntry
  ## Monster card lotto entry, reader 0x00A51C20 (2634).
  i64 reg_uid
  i64 char_uid
  i32 lotto_key
  vector<i32> numbers        # 0x004D9610
  bool rewarded
end

message 2603 MonsterCardChangeListNot
  ## Handler 0x00607BB0 (assert: vecNewCard >> vecDelCard >> bFromRandomCard).
  vector<MonsterCardInfo> new_cards
  vector<i64> del_cards
  bool from_random_card
end

message 2604 MonsterCardInsertReq header?
  ## Insert monster card request.
  i64 item_uid
end

message 2605 MonsterCardInsertAck
  ## Reply to 2604.
  u32 result
end

message 2606 MonsterCardMergeReq header?
  ## Merge monster cards request.
  vector<i64> card_uids
end

message 2607 MonsterCardMergeAck ok_only
  ## Handler 0x00603610 (assert: vecNewCard >> vecDelCard >> nCurAr).
  u32 result
  vector<MonsterCardInfo> new_cards
  vector<i64> del_cards
  i64 cur_ar
end

message 2610 MonsterCardSetCharDeckReq header?
  ## Equip monster card deck request.
  vector<i64> deck_uids
end

message 2611 MonsterCardSetCharDeckAck ok_only
  ## Handler 0x00604100.
  u32 result
  vector<i64> deck_uids
  vector<MonsterCardInfo> updated_cards
end

message 2613 MonsterCardReleaseAllCharReq header?
  ## Release all equipped monster cards request.
  i64 card_uid
end

message 2614 MonsterCardReleaseAllCharAck ok_only
  ## Handler 0x006043F0 (assert: vecDeck >> jCard).
  u32 result
  vector<i64> deck_uids
  MonsterCardInfo card = MonsterCardInfo()
end

message 2615 MonsterCardExtendSlotReq header?
  ## Extend monster card inventory slot request.
  i16 count = 1
end

message 2616 MonsterCardExtendSlotAck ok_only
  ## Handler 0x00604990 (assert: m_sMaxInvenCnt >> nCurAr).
  u32 result
  i16 max_inven_cnt = 50
  i64 cur_ar
end

message 2619 MonsterCardInsertAlbumNot
  ## Handler 0x00604850 (assert: nAlbumCardID).
  i32 album_card_id
end

message 2632 MonsterCardChangeEventCardListNot
  ## Handler 0x00604CA0 (assert: mapNewEventCard >> m_nEventPoint).
  map<i32,i32> new_event_cards
  i32 event_point
end

message 2633 MonsterCardLottoRegReq header?
  ## Register monster card lotto numbers.
  vector<i32> numbers
end

message 2634 MonsterCardLottoRegAck ok_only
  ## Handler 0x00604E90 (assert: jLottoEntry >> mapEventCardOut >> nCurAr).
  u32 result
  MonsterCardLottoEntry entry = MonsterCardLottoEntry()
  map<i32,i32> event_cards_out
  i64 cur_ar
end

message 2635 MonsterCardLottoNumberNot
  ## Monster card lotto number notice.
  i32 lotto_key
  vector<i32> win_numbers
end

message 2636 MonsterCardGetRewardLottoReq header?
  ## Claim monster card lotto reward.
  i64 lotto_reg_uid
end

message 2637 MonsterCardGetRewardLottoAck ok_only
  ## Handler 0x006052C0 (assert: nLottoRegUID >> nRank >> vecItemOut).
  u32 result
  i64 lotto_reg_uid
  i32 rank
  vector<Item> items
end

message 2638 MonsterCardGetRewardPointArrivalReq header?
  ## Claim monster card event point reward.
  i32 choice_point
end

message 2639 MonsterCardGetRewardPointArrivalAck ok_only
  ## Handler 0x005FB240 (assert: nChoicePoint >> vecOut).
  u32 result
  i32 choice_point
  vector<Item> items
end

message 2643 MonsterCardLottoInfoNot
  ## Handler 0x005F9310 (assert: m_nCurLottoKey >> m_tEventStartDate >> m_tEventEndDate >> m_tLottoStartDate >> m_mapWinCardDeck >> m_mapWinCnt).
  i32 cur_lotto_key
  raw[12] event_start_date
  raw[12] event_end_date
  raw[12] lotto_start_date
  map<u32,set<u32>> win_card_decks  # m_mapWinCardDeck (0x005F6640)
  map<?> _                   # m_mapWinCnt (0x005F6730)
end

message 2644 MonsterCardLottoNotifyNot
  ## Monster card lotto notification.
  i32 lotto_key
end

message 2645 MonsterCardLottoInfoUpdateNot
  ## Handler 0x006059C0 (assert: nNewLottoEntryTime >> setWinNum >> vecWinCount).
  i32 new_lotto_entry_time
  set<i32> win_nums
  vector<i32> win_counts
end
