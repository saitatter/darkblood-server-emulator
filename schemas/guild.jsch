# Guild creation, membership, money, notices and skills. Format: schemas/README.md.
# Request senders are from research/opcode_xrefs.tsv; writer widths as in skills.jsch.
# `wrest`/`wstrz` keep the earlier raw UTF-16 forms where no sender is recovered.

domain guild Dark Blood protocol wire messages - Guild domain.

extern Item from darkblood.games.entities.items
extern AddedItemNotice from darkblood.games.network.messages.inventory readable

message 2150 GuildCreateReq header?
  ## No sender recovered; kept as the earlier raw UTF-16 form.
  wrest guild_name
end

message 5121 GuildCreateProposalReq header?
  ## Sender 0x007935F0 writes a J-wstring.
  wstr guild_name
end

message 2151 GuildCreateAck ok_only
  ## On_eEGS_GUILD_CREATE_ACK 0x00793720.
  i32 result
  i64 guild_uid = 1
  wstrz guild_name           # null-terminated UTF-16 as sent so far; reader not checked
  i64 remain_gold
end

message 5122 GuildCreateProposalAck
  ## On_eERC_GUILD_CREATE_PROPOSAL_ACK 0x00759750.
  i32 result
end

message 2155 GuildPersonJoinReq header?
  ## Sender 0x00793DF0.
  i64 guild_uid
end

message 2156 GuildPersonJoinAck
  ## On_eEGS_GUILD_PERSON_JOIN_ACK 0x0075A220.
  i32 result
end

message 2160 GuildInviteReq header?
  ## No sender recovered; kept as the earlier raw UTF-16 form.
  wrest char_name
end

message 2161 GuildInviteAck
  ## On_eEGS_GUILD_INVITE_ACK 0x00759870.
  i32 result
end

message 2162 GuildPersonLeaveReq header?
  ## Sender 0x00793C90 writes no fields.
end

message 2163 GuildPersonLeaveAck
  ## On_eEGS_GUILD_PERSON_LEAVE_ACK 0x00759CA0.
  i32 result
end

message 2179 GuildMoneyInReq header?
  ## Sender 0x007941A0.
  i64 amount
end

message 2180 GuildMoneyInAck ok_only
  ## On_eEGS_GUILD_MONEY_IN_ACK 0x00794250.
  i32 result
  i64 remain_gold            # written to player +0x70
end

message 2181 GuildMoneyOutReq header?
  ## Sender 0x007943C0.
  i64 amount
end

message 2182 GuildMoneyOutAck ok_only
  ## On_eEGS_GUILD_MONEY_OUT_ACK 0x00794470.
  i32 result
  i64 remain_gold            # written to player +0x70
end

message 2183 GuildLevelUpReq header?
  ## Sender 0x007945E0 writes no fields.
end

message 2184 GuildLevelUpAck ok_only
  ## On_eEGS_GUILD_LEVEL_UP_ACK 0x00753380.
  i32 result
  i16 new_level = 1
end

message 2185 GuildNoticeModifyReq header?
  ## Sender 0x00794660 writes a J-wstring.
  wstr notice
end

message 2186 GuildNoticeModifyAck
  ## On_eEGS_GUILD_NOTICE_MODIFY_ACK 0x0075A120.
  i32 result
end

message 2188 GuildNoticeDeleteReq header?
  ## No fields known.
end

message 2189 GuildNoticeDeleteAck
  ## On_eEGS_GUILD_NOTICE_DELETE_ACK 0x0074B830.
  i32 result
end

message 2214 GuildAllSkillInitReq header?
  ## No fields known.
end

message 2215 GuildAllSkillInitAck ok_only
  ## Handler 0x00752D80.
  i32 result
  i32 param                  # meaning unknown
end

message 2314 GuildNameChangeReq header?
  ## Sender 0x00798A70: 0x00B353D0 then a J-wstring (the earlier decoder read the
  ## name first).
  i64 item_uid               # meaning of the i64 not confirmed
  wstr new_name
end

message 2315 GuildNameChangeAck
  ## Handler 0x00780590.
  i32 result
  vector<Item> items
  wstr new_name
end

struct GuildInfo
  ## jGuild, reader 0x00A49A10 (variable length: two J-wstrings; the earlier raw[64]
  ## could not match it). Consumed by JGuildManager::OnGuildInfoNot 0x0092A2A0, which
  ## copies the whole struct (0x0091A150) and sets the player's +0x210 guild UID,
  ## a string from +0x0C and +0x234 from +0x29.
  i64 guild_uid              # +0x00 -> player +0x210
  wstr name                  # +0x0C, assigned to the player with the UID (assumed guild name)
  u8 _                       # +0x28
  u16 _ = 1                  # +0x29 -> player +0x234 (1 when guildless, ctor in 0x00966730)
  u32 _                      # +0x2B
  u32 _                      # +0x2F
  u32 _                      # +0x33
  u32 _                      # +0x37
  u32 _                      # +0x3B
  u32 _                      # +0x3F
  i64 _                      # +0x43
  wstr _                     # +0x4B
  u64 _                      # +0x67 (0x00B356F0)
  i64 _                      # +0x6F
  u64 _                      # +0x77
  u64 _                      # +0x7F
  u64 _                      # +0x87
  u32 _                      # +0x08 (read last)
end

struct GuildMember
  ## Element of 2158 vecModifyPersonList: 0x00763970 -> 0x0074CF70 -> 0x00A49950.
  ## Field meanings are not recovered; types follow the reader.
  i64 _                      # +0x00
  i64 _                      # +0x08
  wstr _                     # +0x10
  u16 _                      # +0x2C
  u16 _                      # +0x2E
  u8 _                       # +0x30
  u8 _                       # +0x31
  u16 _                      # +0x32
  u32 _                      # +0x34
  u64 _                      # +0x38
  u64 _                      # +0x40
  i64 _                      # +0x6C
  i64 _                      # +0x74
  u32 _                      # +0x48
  u32 _                      # +0x4C
  wstr _                     # +0x50
end

message 2157 GuildInfoNot
  ## Handler 0x00752FF0 (assert: jGuild).
  GuildInfo guild = GuildInfo()
end

message 2158 GuildPersonListNot
  ## Handler 0x0077ABA0 (assert: vecModifyPersonList).
  vector<GuildMember> members  # vecModifyPersonList
end

message 2164 GuildPersonGradeModifyReq header?
  ## Sender 0x00793D10: tag 0x10 vector (0x004CB5E0), then 0x00B35190.
  vector<i64> member_uids
  i16 new_grade = 1
end

message 2165 GuildPersonGradeModifyAck ok_only
  ## Handler 0x00753170.
  i32 result
  i64 member_uid
  i16 new_grade = 1
end

struct GuildSkillEntry
  ## Guild skill record, reader 0x00A48890 (16 raw bytes; ctor in 0x0076E9B0).
  u16 skill_id = 0xFFFF
  u8 skill_level
  bool is_used
  u32 remain_time
  u32 cool_time
  u32 param
end

message 2205 GuildSkillNot
  ## Handler 0x00779390.
  bool flag
  vector<GuildSkillEntry> skills
end

struct GuildHistoryEntry
  ## Guild history log entry, reader 0x00A49AE0 (2159).
  i64 history_uid            # +0x00
  i64 guild_uid              # +0x08
  i16 history_type           # +0x10
  i64 actor_uid              # +0x12
  i64 target_uid             # +0x1A
  wstr actor_name            # +0x22
  wstr target_name           # +0x3E
  wstr detail                # +0x5A
  i64 timestamp              # +0x76
end

message 2159 GuildHistoryNot
  ## Handler 0x0077AD40 (assert: bFullHistory >> vecNewHistory, reader 0x00773BC0).
  bool full_history
  vector<GuildHistoryEntry> entries
end

message 2166 GuildFalloutStartReq header?
  ## Sender 0x00793EA0 writes no fields.
end

message 2167 GuildFalloutStartAck
  ## Handler 0x00759D60 (reads u32 result only).
  i32 result
end

message 2168 GuildFalloutStopReq header?
  ## Sender 0x00793FA0 writes no fields.
end

message 2169 GuildFalloutStopAck
  ## Handler 0x0074B830 (reads u32 result only).
  i32 result
end

message 2172 GuildFalloutCompleteNot
  ## Handler 0x00753280 (assert: nDelGuildUID).
  i64 del_guild_uid
end

message 2173 GuildGradeDelegationReq header?
  ## Sender 0x00794020.
  i64 target_uid
end

message 2174 GuildGradeDelegationAck
  ## Handler 0x0074B830 (reads u32 result only).
  i32 result
end

message 2175 GuildPersonExpulsionReq header?
  ## Sender 0x007940D0: tag 0x10 vector<i64> (0x004CB5E0).
  vector<i64> member_uids
end

message 2176 GuildPersonExpulsionAck
  ## Handler 0x0074B830 (reads u32 result only).
  i32 result
end

message 2187 GuildViewedNoticeNot header?
  ## Sender 0x00794700: i64 timestamp (fire-and-forget).
  i64 notice_time
end

message 2190 GuildDismissalStartReq header?
  ## Sender 0x007947A0 writes no fields.
end

message 2191 GuildDismissalStartAck
  ## Handler 0x0074B830 (reads u32 result only).
  i32 result
end

message 2192 GuildDismissalStopReq header?
  ## Sender 0x00794820 writes no fields.
end

message 2193 GuildDismissalStopAck
  ## Handler 0x0074B830 (reads u32 result only).
  i32 result
end

message 2206 GuildLearnSkillReq header?
  ## Sender 0x00794B10.
  i16 skill_id
  u8 skill_level
end

message 2207 GuildLearnSkillAck
  ## Handler 0x0074B820 (reads u32 result only).
  i32 result
end

message 2208 GuildSkillChangeUseStateReq header?
  ## Sender 0x00794BC0.
  i16 skill_id
end

message 2209 GuildSkillChangeUseStateAck
  ## Handler 0x0074B820 (reads u32 result only).
  i32 result
end

message 2218 RefuseGuildInviteNot header?
  ## Sender 0x00795000.
  wstr inviter_name
end

message 5123 GuildCreateCompleteNot
  ## Handler 0x00759E10 (assert: nNewGuildUID >> strGuildName).
  i64 new_guild_uid
  wstr guild_name
end

message 5127 CurrentGuildSkillNot
  ## Handler 0x00794CE0 (assert: nGuildUID >> nSendCharUID >> vecUseSkill).
  i64 guild_uid
  i64 send_char_uid
  vector<GuildSkillEntry> use_skills
end

message 6015 GuildInviteNot
  ## Handler 0x00759AB0 (eERT_GUILD_INVITE_REQ delivered to invitee).
  ## Assert: strRecvCharNick >> jInfo.m_uidGuild >> jInfo.m_strGuildName >>
  ## jInfo.m_strInviteName >> jInfo.m_strMasterName >> jInfo.m_sGuildLv >> jInfo.m_sMemberCount.
  wstr recv_char_nick
  i64 guild_uid
  wstr guild_name
  wstr invite_name
  wstr master_name
  i16 guild_lv = 1
  i16 member_count = 1
end

message 6016 GuildInviteResultAck
  ## Handler 0x00759990 (eERT_GUILD_INVITE_ACK; reads u32 result only).
  i32 result
end

message 6017 GuildPersonExpulsionCompleteNot bare
  ## Handler 0x0075A000 (empty body; clears client guild state and shows GAME_281).
end

message 6019 RefuseGuildInviteForwardNot
  ## Handler 0x0075A420 (assert: strMyNick >> strRefuserNick).
  wstr my_nick
  wstr refuser_nick
end

message 2674 GuildPersonIntroductionReq header?
  ## Sender 0x007A67D0.
  wstr greeting
  wstr memo
end

message 2675 GuildPersonIntroductionAck ok_only
  ## Handler 0x0075CCA0 (assert: strGreeting >> strMemo).
  i32 result
  wstr greeting
  wstr memo
end

message 2677 GuildMissionNot
  ## Handler 0x00753DF0 (assert: jGuildMission, reader 0x00A4A330).
  i64 guild_uid              # +0x00
  i64 mission_uid            # +0x08
  wstr mission_name          # +0x10
  i32 mission_id             # +0x2C
  i32 cur_count              # +0x30
  i32 max_count              # +0x34
  i32 reward_point           # +0x38
  i64 expire_time            # +0x3C
  i64 update_time            # +0x44
end

struct GuildBrokerEntry
  ## Guild auction/broker item entry, reader 0x00A4A3A0 (2679).
  i32 broker_id              # +0x00
  u8 state                   # +0x04
  i32 item_id                # +0x05
  i16 item_count             # +0x09
  i64 bid_guild_uid          # +0x0B
  wstr bid_guild_name        # +0x13
  i32 bid_point              # +0x2F
  i32 min_point              # +0x33
end

message 2678 GuildBrokerListReq header?
  ## Sender 0x007A6880 writes no fields.
end

message 2679 GuildBrokerListAck ok_only
  ## Handler 0x00776950 (assert: mapGuildBroker >> nRemainSecond).
  i32 result
  map<i32,GuildBrokerEntry> brokers
  i64 remain_second
end

message 2680 GuildBrokerBidReq header?
  ## Sender 0x007A6900.
  i32 broker_id
  i32 bid_point
end

message 2681 GuildBrokerBidAck ok_only
  ## Handler 0x0075D040 (assert: nID >> nBidPoint).
  i32 result
  i32 broker_id
  i32 bid_point
end

message 2682 GuildBrokerReturnPointReq header?
  ## Sender 0x007A6A50.
  i32 broker_id
end

message 2683 GuildBrokerReturnPointAck ok_only
  ## Handler 0x0075D180 (assert: nID >> nReturnPoint).
  i32 result
  i32 broker_id
  i32 return_point
end

message 2684 GuildSupplyGetRewardReq header?
  ## Sender 0x007A6AF0.
  i64 supply_reward_uid
end

message 2685 GuildSupplyGetRewardAck ok_only
  ## Handler 0x00783F70 (assert: nSupplyRewardUID >> vecItemOut).
  i32 result
  i64 supply_reward_uid
  vector<Item> items
end

message 2686 GuildSupplyListNot
  ## Handler 0x00772920 (assert: mapRewardItem >> vecRewardBuff).
  map<i64,AddedItemNotice> reward_items
  vector<i32> reward_buffs
end

message 2426 GuildPersonArenaGradeModifyReq header?
  ## Request for 2427.
  vector<i64> char_uids
  i16 arena_permission
end

message 2427 GuildPersonArenaGradeModifyAck ok_only
  ## Handler 0x00771D70 (assert: vecChangeCharUID >> sChangeArenaPermission).
  i32 result
  vector<i64> char_uids
  i16 arena_permission
end

struct SiegeTeamMembers
  ## Value for map<i16, set<i64>> in 2454/2455/2456 (0x006BB6B0).
  set<i64> member_uids
end

message 2450 GuildSiegeChangeOfficerReq header?
  ## Request for 2451.
  i64 change_char_uid
end

message 2451 GuildSiegeChangeOfficerAck ok_only
  ## Handler 0x0076CA40 (assert: nChangeCharUID >> mapChangeCharUID).
  i32 result
  i64 change_char_uid
  map<i64,i16> changed_chars
end

message 2452 GuildSiegeChangeOfficerNot
  ## Handler 0x00753B90 (assert: nNewOfficerUID).
  i64 new_officer_uid
end

message 2453 GuildPersonSiegeTeamIdxModifyReq header?
  ## Sender 0x0079DE80 (writer 0x00760AF0: map<i64, i16>).
  map<i64,i16> team_changes
end

message 2454 GuildPersonSiegeTeamIdxModifyAck ok_only
  ## Handler 0x0077C550 (assert: mapTeamCharList, reader 0x0077BEC0).
  i32 result
  map<i16,SiegeTeamMembers> team_char_list
end

message 2455 GuildPersonSiegeTeamIdxModifyNot
  ## Handler 0x0077C860 (assert: mapTeamCharList, reader 0x0077BEC0).
  map<i16,SiegeTeamMembers> team_char_list
end

message 2456 GuildUpdateSiegeInfoNot
  ## Handler 0x0077C370 (assert: jNewGuildSiegeinfo, reader 0x00A54CC0).
  i64 guild_uid
  i64 siege_officer_uid
  map<i16,SiegeTeamMembers> team_char_list
end

message 2599 CitadelRoundClearReq header?
  ## Sender 0x007A4D80 (assert: nCurRound).
  i32 cur_round
end

message 2600 CitadelRoundClearAck ok_only
  ## Handler 0x0075BF20 (assert: nNextRound).
  i32 result
  i32 next_round
end

message 2631 CitadelPlayCountUpdateNot
  ## Handler 0x007A5580 (assert: sRemainCitadelPlayCount; writes player +0x304).
  i16 remain_play_count
end

message 2676 UpdateCitadelHistoryNot ok_only
  ## Handler 0x0075CEF0 (assert: strDunID).
  i32 result
  wstr dun_id
end
